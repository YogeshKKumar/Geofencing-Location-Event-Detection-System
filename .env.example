# ==============================================================================
# GEOFENCING & LOCATION EVENT DETECTION SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application
PROJECT_NAME="Geofencing & Location Event Detection System"
API_V1_STR=/api/v1
ENVIRONMENT=development

# MySQL Database
MYSQL_SERVER=localhost
MYSQL_PORT=3306
MYSQL_USER=geofence_user
MYSQL_PASSWORD=geofence_password
MYSQL_DB=geofencing_db
# Direct SQLAlchemy connection string override:
# DATABASE_URL=mysql+pymysql://geofence_user:geofence_password@localhost:3306/geofencing_db

# Security & Authentication
JWT_SECRET=supersecretjwtkeyforproductiongeofencingplatform2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Geofencing Engine Thresholds
GEOFENCE_ACCURACY_THRESHOLD_METERS=100.0
GEOFENCE_HYSTERESIS_METERS=10.0
GEOFENCE_DEDUPLICATION_WINDOW_SECONDS=5.0

# CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
